export TSBS_QUERY_TIMESTAMP_END="2026-01-04T00:00:01Z"
export TSBS_LOG_INTERVAL="10s"
export TSBS_SEED="123"
export TSBS_QUERY_COUNT="1000"
export TSBS_EXPECTED_HOURS="72"
export TSBS_RESULT_SET="tsbs_reference_scale4000_3d_10s_seed123"
